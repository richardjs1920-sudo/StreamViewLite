<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" 
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content">

        <TextView
            android:text="StreamView Lite"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
            android:layout_width="wrap_content" 
            android:layout_height="wrap_content" 
            android:layout_marginBottom="24dp" />

        <Button 
            android:id="@+id/btnPickMedia"
            android:text="@string/pick_video" 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtMediaInfo"
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:text="@string/status_no_video"
            android:textStyle="italic"
            android:layout_marginTop="8dp"/>

        <EditText 
            android:id="@+id/editUrl"
            android:hint="@string/rtmp_url"
            android:inputType="textUri"
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>

        <EditText 
            android:id="@+id/editKey"
            android:hint="@string/stream_key"
            android:inputType="text"
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"/>

        <Button 
            android:id="@+id/btnSave"
            android:text="@string/save"
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <Button 
            android:id="@+id/btnBrowser"
            android:text="@string/open_browser"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <Button 
            android:id="@+id/btnStart"
            android:text="@string/start_stream"
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>
